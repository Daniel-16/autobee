<?xml version="1.0"?>
<package format="3">
  <name>autobee_tello</name>
  <version>0.1.0</version>
  <description>DJI Tello driver: bridges djitellopy to the AutoBee /drone/* topic graph.</description>
  <maintainer email="danieloloruntoba681@gmail.com">Daniel Oloruntoba</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
