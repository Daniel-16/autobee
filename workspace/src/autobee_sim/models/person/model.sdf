<?xml version="1.0"?>
<!--
  Person stand-in for AutoBee perception testing.

  KNOWN LIMITATION: YOLOv8n trained on COCO does not reliably detect these
  geometric primitives as the "person" class (domain gap from photo-real
  training data). The autonomy pipeline (perception -> analytics -> anomaly
  -> report) is deliberately built to handle zero-detection streams honestly,
  so an empty result here is a correct demonstration of robustness rather
  than a pipeline failure. On real Tello camera footage of real humans,
  the same yolov8_perception_node returns COCO-published mAP performance.
-->
<sdf version="1.6">
  <model name="person">
    <static>true</static>
    <link name="body">
      <visual name="head">
        <pose>0 0 1.65 0 0 0</pose>
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><diffuse>0.95 0.78 0.62 1</diffuse><ambient>0.95 0.78 0.62 1</ambient></material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.05 0 0 0</pose>
        <geometry><box><size>0.4 0.25 0.6</size></box></geometry>
        <material><diffuse>0.2 0.45 0.75 1</diffuse><ambient>0.2 0.45 0.75 1</ambient></material>
      </visual>
      <visual name="larm">
        <pose>-0.25 0 1.0 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
        <material><diffuse>0.2 0.45 0.75 1</diffuse><ambient>0.2 0.45 0.75 1</ambient></material>
      </visual>
      <visual name="rarm">
        <pose>0.25 0 1.0 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.65</length></cylinder></geometry>
        <material><diffuse>0.2 0.45 0.75 1</diffuse><ambient>0.2 0.45 0.75 1</ambient></material>
      </visual>
      <visual name="lleg">
        <pose>-0.1 0 0.43 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.85</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.3 1</diffuse><ambient>0.15 0.15 0.3 1</ambient></material>
      </visual>
      <visual name="rleg">
        <pose>0.1 0 0.43 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.85</length></cylinder></geometry>
        <material><diffuse>0.15 0.15 0.3 1</diffuse><ambient>0.15 0.15 0.3 1</ambient></material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><box><size>0.45 0.35 1.7</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
